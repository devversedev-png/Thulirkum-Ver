# The built-in fallback uses OpenStreetMap Nominatim.
VITE_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

# Backend (Spring Boot)
MONGODB_URI=mongodb://localhost:27017/thulirkumver
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ALLOWED_ORIGIN=http://localhost:5173
ADMIN_NAME=Thulirkum Ver Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

